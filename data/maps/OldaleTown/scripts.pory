script OldaleTown_EventScript_TaxiNoticePlayer {
	playse(SE_PIN)
	applymovement(LOCALID_OLDALE_RIDE_CALLER_MAN, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_OLDALE_RIDE_CALLER_MAN, Common_Movement_Delay48)
	waitmovement(0)
	msgbox(format("Oh! You there! I haven't told you about our Corviknight ride service yet. Come here a moment, would you?"))
	closemessage
	return
}

script OldaleTown_EventScript_TaxiNoticePlayerFromLeft {
	applymovement(LOCALID_OLDALE_RIDE_CALLER_MAN, OldaleTown_Movement_TaxiFaceLeft)
	waitmovement(0)
	call(OldaleTown_EventScript_TaxiNoticePlayer)
	return
}

